[sub_resource type="Shader" id="Shader_maplw"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.3.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;

uniform float roughness : hint_range(0.0, 1.0);

uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform float deform_ratio : hint_range(0.0, 1.0, 0.01) = 1.0;
const float radius = 0.045;
const float deform_scale = 0.25;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;
	float deform_strength = deform_ratio * deform_ratio;
	float dist_to_border = clamp((length(VERTEX.xz)) / radius, 0.0, 1.0);
	// sin(acos(dist_to_border)) approx by 1 - |x|^3
	VERTEX.y += (1.0 - abs(dist_to_border * dist_to_border * dist_to_border)) * deform_strength * radius * deform_scale;
	VERTEX.xz *= mix(1.0, 1.08, deform_strength);
}

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;

	METALLIC = metallic;
	SPECULAR = specular;

	ROUGHNESS = roughness;
}
"

